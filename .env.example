# Everything defaults to mock/local mode - an empty .env runs the full demo offline.

# --- API ---
API_HOST=127.0.0.1
API_PORT=8000
# Optional: require X-API-Key on every API call (dashboard: open /dashboard/?key=...)
API_KEY=
# Where finished-match passports + event logs are exported
PASSPORT_DIR=data/passports

# --- Vector store: auto | tencent | pinecone | chroma | memory ---
# auto = Tencent VectorDB if TENCENT_VDB_URL/KEY are set, else Pinecone if PINECONE_API_KEY is set,
#        else Chroma (in-memory), else pure in-memory. Writes are always mirrored locally.
VECTOR_BACKEND=auto
TENCENT_VDB_URL=
TENCENT_VDB_USERNAME=root
TENCENT_VDB_KEY=
TENCENT_VDB_DATABASE=clanfall
TENCENT_VDB_COLLECTION=match_facts

# Pinecone serverless (64-dim, cosine). The index can be shared: Clanfall writes only to its own
# clanfall-<id> namespace and deletes just that namespace on every wipe. Created if missing.
PINECONE_ENABLED=true
PINECONE_API_KEY=
PINECONE_INDEX=clanfall-match-facts
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1

# --- Knowledge graph: auto | neo4j | networkx ---
# auto = Neo4j if NEO4J_URI/PASSWORD are set and reachable, else embedded NetworkX (always mirrored).
# The database can be shared: Clanfall nodes carry the ClanfallNode label + a per-run engine id,
# and a wipe deletes exactly those nodes (verified with a server-side count).
GRAPH_BACKEND=auto
NEO4J_ENABLED=true
# Neo4j Aura: neo4j+s://<instance-id>.databases.neo4j.io
NEO4J_URI=
NEO4J_USER=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j
# bolt (7687) | http (Query API over HTTPS 443, for networks that block 7687) | auto = bolt then http
NEO4J_TRANSPORT=auto

# --- MongoDB document store (episodic events, semantic facts, evidence; wiped every match) ---
MONGO_ENABLED=true
MONGO_URI=
MONGO_DB=clanfall

# --- Chain: mock | testnet ---
# mock = in-process MatchLedger replica (same checks, same error names)
CHAIN_MODE=mock
CHAIN_RPC_URL=https://sepolia.base.org
# TESTNET-ONLY key. Never put a key that holds real funds here.
CHAIN_PRIVATE_KEY=
# Printed by: python -m chain.contracts.deploy
MATCH_LEDGER_ADDRESS=
# Stretch contracts (same deploy command). Unset = in-process mock versions.
PASSPORT_NFT_ADDRESS=
LEADERBOARD_ADDRESS=
NFT_ENABLED=true
# Host -> player gas top-up so a player can send their own opt-in tx
LEADERBOARD_GAS_TOPUP_ETH=0.00002
CHAIN_ID=84532
CHAIN_EXPLORER_TX_URL=https://sepolia.basescan.org/tx/

# --- Groq (optional: rephrases evidence headlines; templates used otherwise) ---
GROQ_ENABLED=false
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_BASE_URL=https://api.groq.com/openai/v1
